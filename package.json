    "react-dom": "^16.8.0",
    "react-hot-loader": "next",
    "react-redux": "^5.0.6",
    "redux": "^3.7.2",
    "style-loader": "^0.18.1",
    "uglifyjs-webpack-plugin": "^2.1.1",
    "url-loader": "^1.1.2",
    "webpack": "^4.28.4",
    "webpack-cli": "^3.2.1",
    "webpack-dev-server": "^3.1.14"
